# ==========================================
# Manhua Manager Pro — Environment Variables
# ==========================================

# Environment Mode: development | production | test
ENV=development

# ------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------
DB_USER=manhua_user
DB_PASSWORD=manhua_secure_password_change_me
DB_NAME=manhua_pro
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://manhua_user:manhua_secure_password_change_me@postgres:5432/manhua_pro?sslmode=disable

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
REDIS_PASSWORD=redis_secure_password_change_me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:redis_secure_password_change_me@redis:6379/0

# ------------------------------------------
# API Gateway Core (Go)
# ------------------------------------------
PORT=8080
JWT_SECRET=super_secret_jwt_hmac_sha256_minimum_32_characters_key
JWT_EXPIRES_IN=15m
REFRESH_SECRET=super_secret_refresh_jwt_minimum_32_characters_key
REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------
# Scraping Worker Pool (Node.js/Puppeteer)
# ------------------------------------------
SCRAPER_WORKER_URL=scraping-workers:50051
SCRAPER_PORT=50051
MAX_CONCURRENT_BROWSERS=5

# ------------------------------------------
# Capas locais (somente ManhuaUS e RavenScans)
# ------------------------------------------
COVERS_DIR=/data/covers
COVERS_MAX_BYTES=8388608
COVER_PROFILES_DIR=/data/cover-profiles
COVER_BROWSER_HEADLESS=true
COVER_BROWSER_EXECUTABLE=/opt/cover-chrome/chrome-linux64/chrome

# Opcional: coleta de catálogo/capas de ManhuaUS e RavenScans no host.
# Instale com make collector-install; o worker dos outros provedores permanece no Docker.
CATALOG_COLLECTOR_URL=http://scraping-workers:50051
CATALOG_COLLECTOR_TOKEN=

# ------------------------------------------
# Cloudflare R2 / S3 (reservado para futura migração)
# ------------------------------------------
R2_BUCKET_NAME=manhua-covers
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ------------------------------------------
# Firebase Cloud Messaging (FCM)
# ------------------------------------------
FIREBASE_PROJECT_ID=manhua-manager-pro
FIREBASE_CREDENTIALS_JSON=

# ------------------------------------------
# Frontend Web Client
# ------------------------------------------
WEB_PORT=4200
API_URL=http://localhost:8080
